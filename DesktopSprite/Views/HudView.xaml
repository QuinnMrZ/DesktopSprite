<UserControl x:Class="DesktopSprite.Views.HudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DesktopSprite.Views">
    <!-- 背景整体透明：只有圆环本身可见 -->
    <Border x:Name="Root" Background="#01000000">
        <Grid>
            <!-- 连接线 + 标题（仅展开态可见） -->
            <Canvas x:Name="LinkCanvas">
                <Line X1="150" Y1="170" X2="52" Y2="86" Stroke="#14FFFFFF" StrokeThickness="1" />
                <Line X1="150" Y1="170" X2="248" Y2="86" Stroke="#14FFFFFF" StrokeThickness="1" />
                <Line X1="150" Y1="170" X2="52" Y2="254" Stroke="#14FFFFFF" StrokeThickness="1" />
                <Line X1="150" Y1="170" X2="248" Y2="254" Stroke="#14FFFFFF" StrokeThickness="1" />

                <TextBlock Canvas.Left="0" Canvas.Top="10" Width="300"
                           TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="#C9D4E8">
                    <Run Text="System Monitor " />
                    <Run Text="●" Foreground="#34D399" />
                </TextBlock>
            </Canvas>

            <!-- 仪表层 -->
            <Canvas x:Name="GaugeCanvas">
                <views:RingGauge x:Name="CpuGauge"
                                 Canvas.Left="75" Canvas.Top="95"
                                 Width="150" Height="150"
                                 RenderTransformOrigin="0.5,0.5" />

                <Grid x:Name="GpuHost" Canvas.Left="13" Canvas.Top="47" Width="78" Height="78"
                      Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="GpuScale" ScaleX="0.25" ScaleY="0.25" />
                            <TranslateTransform x:Name="GpuTranslate" X="98" Y="84" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <views:RingGauge x:Name="GpuGauge" Width="78" Height="78" />
                </Grid>

                <Grid x:Name="VramHost" Canvas.Left="209" Canvas.Top="47" Width="78" Height="78"
                      Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="VramScale" ScaleX="0.25" ScaleY="0.25" />
                            <TranslateTransform x:Name="VramTranslate" X="-98" Y="84" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <views:RingGauge x:Name="VramGauge" Width="78" Height="78" />
                </Grid>

                <Grid x:Name="RamHost" Canvas.Left="13" Canvas.Top="215" Width="78" Height="78"
                      Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="RamScale" ScaleX="0.25" ScaleY="0.25" />
                            <TranslateTransform x:Name="RamTranslate" X="98" Y="-84" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <views:RingGauge x:Name="RamGauge" Width="78" Height="78" />
                </Grid>

                <Grid x:Name="NetHost" Canvas.Left="209" Canvas.Top="215" Width="78" Height="78"
                      Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NetScale" ScaleX="0.25" ScaleY="0.25" />
                            <TranslateTransform x:Name="NetTranslate" X="-98" Y="-84" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <views:RingGauge x:Name="NetGauge" Width="78" Height="78" />
                </Grid>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
