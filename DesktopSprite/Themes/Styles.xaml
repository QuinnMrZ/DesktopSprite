<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PanelBackground" Color="#E6151720" />
    <SolidColorBrush x:Key="PanelBorder" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8B92A8" />
    <SolidColorBrush x:Key="BarTrack" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AccentGreen" Color="#4CD964" />
    <SolidColorBrush x:Key="AccentAmber" Color="#FFC94A" />
    <SolidColorBrush x:Key="AccentRed" Color="#FF5A5A" />
    <SolidColorBrush x:Key="NetDown" Color="#4CC9F0" />
    <SolidColorBrush x:Key="NetUp" Color="#A78BFA" />

    <Style x:Key="MetricBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource AccentGreen}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                CornerRadius="3"
                                Background="{StaticResource BarTrack}" />
                        <Border x:Name="PART_Indicator"
                                CornerRadius="3"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="MenuStyle" TargetType="MenuItem">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
