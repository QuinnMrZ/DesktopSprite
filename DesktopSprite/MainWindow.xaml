<Window x:Class="DesktopSprite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DesktopSprite.Views"
        Title="System Monitor"
        Width="300"
        Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        PreviewMouseWheel="OnPreviewMouseWheel">

    <Window.ContextMenu>
        <ContextMenu Background="#F5181B24" Foreground="#EEF1F8" BorderBrush="#33FFFFFF" BorderThickness="1">
            <MenuItem x:Name="MenuTopmost" Header="始终置顶" IsCheckable="True" Click="MenuTopmost_Click" />
            <MenuItem x:Name="MenuClickThrough" Header="点击穿透" IsCheckable="True" Click="MenuClickThrough_Click" />
            <MenuItem x:Name="MenuLock" Header="锁定位置" IsCheckable="True" Click="MenuLock_Click" />
            <MenuItem x:Name="MenuAutoStart" Header="开机启动" IsCheckable="True" Click="MenuAutoStart_Click" />
            <Separator />
            <MenuItem Header="重置位置" Click="MenuResetPosition_Click" />
            <MenuItem Header="关于" Click="MenuAbout_Click" />
            <MenuItem Header="退出" Click="MenuExit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Viewbox Stretch="Fill">
        <Grid x:Name="LayoutRoot" Width="300" Height="340">
            <views:HudView x:Name="Hud" />
        </Grid>
    </Viewbox>
</Window>
